{
  "name": "the-portugal-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "node --experimental-strip-types scripts/validate-content.ts",
    "check": "astro check",
    "build": "npm run validate -- --production && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:links": "node scripts/check-links.mjs dist",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:e2e": "playwright test",
    "ci": "npm run check && npm run test && npm run build && npm run test:links && npm run test:html && npm run test:parity && npm run test:e2e",
    "test:parity": "node scripts/check-parity.mjs dist",
    "port:legacy": "node scripts/port-legacy.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "astro": "^7.4.7",
    "leaflet": "^1.9.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "html-validate": "^11.19.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
