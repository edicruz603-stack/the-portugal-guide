---
import type { Event } from '../../lib/content/schemas.ts';
import { inline } from '../../lib/content/inline.ts';
import TrustNote from '../TrustNote.astro';
import type { TrustLine } from '../../lib/trust/trust.ts';
interface Props { editorial: NonNullable<Event['editorial']['local']>; trust?: TrustLine[] }
const { editorial: e, trust = [] } = Astro.props;
---
<div class="event"><time set:html={inline(e.when)} /><div><h3 set:html={inline(e.title)} /><p><Fragment set:html={inline(e.text)} /> <a href={e.link.href}>{e.link.label}</a></p><TrustNote lines={trust} /></div></div>
