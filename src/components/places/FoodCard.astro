---
import type { Place } from '../../lib/content/schemas.ts';
import { inline } from '../../lib/content/inline.ts';
import Links from './Links.astro';
interface Props { editorial: NonNullable<Place['editorial']['food_card']> }
const { editorial: e } = Astro.props;
---
<article class="food-card"><h3 set:html={inline(e.title)} />{e.paragraphs.map((p) => <p set:html={inline(p)} />)}<Links links={e.links} /></article>
