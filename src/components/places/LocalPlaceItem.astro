---
import type { Place } from '../../lib/content/schemas.ts';
import { inline } from '../../lib/content/inline.ts';
import Links from './Links.astro';
import TrustNote from '../TrustNote.astro';
import type { TrustLine } from '../../lib/trust/trust.ts';
interface Props { editorial: NonNullable<Place['editorial']['local']>; trust?: TrustLine[] }
const { editorial: e, trust = [] } = Astro.props;
---
<article class="item"><span class="tag" set:html={inline(e.tag)} /><h3 set:html={inline(e.title)} /><p set:html={inline(e.text)} /><Links links={e.links} /><TrustNote lines={trust} /></article>
