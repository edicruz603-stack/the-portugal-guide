---
import type { Place } from '../../lib/content/schemas.ts';
import { inline } from '../../lib/content/inline.ts';
import Links from './Links.astro';
import TrustNote from '../TrustNote.astro';
import type { TrustLine } from '../../lib/trust/trust.ts';
interface Props { editorial: NonNullable<Place['editorial']['romantic']>; trust?: TrustLine[] }
const { editorial: e, trust = [] } = Astro.props;
---
<article class="card"><span class="number" set:html={inline(e.label)} /><h3 set:html={inline(e.title)} /><p set:html={inline(e.text)} />{e.meta && <p class="meta" set:html={inline(e.meta)} />}<Links links={e.links} /><TrustNote lines={trust} /></article>
