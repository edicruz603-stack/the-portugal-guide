---
// Ported from legacy /index.html by scripts/port-legacy.mjs (Phase 1).
// Editorial content is unchanged; see docs/phase-0-1-report.md.
import Base from '../layouts/Base.astro';
import DestinationCard from '../components/DestinationCard.astro';
import homeDestinations from '../data/home-destinations.json';
---
<Base
  title="The Portugal Guide — Discover Portugal beyond the obvious"
  description="Discover Portugal beyond the obvious with thoughtful local guides, practical advice and places worth slowing down for."
  nav={[["#destinations","Destinations"],["#our-way","Our way"],["#about","About"]]}
  cta={["sintra.html","Explore the guides"]}
>
<main id="main" tabindex="-1">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">A little more local. A lot more Portugal.</p>
        <h1>Discover Portugal<br><em>beyond the obvious.</em></h1>
        <p class="hero-intro">Thoughtful guides for curious travellers. Find the places, flavours and small details that make a trip feel like your own.</p>
        <a class="button button-light" href="sintra.html">Explore the Sintra guide <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-note">
        <span class="note-line"></span>
        <span>Made with care in Portugal</span>
      </div>
    </section>

    <section class="intro section-wrap" id="our-way">
      <p class="eyebrow">Travel at your own pace</p>
      <h2>Not just places to see.<br><em>Stories to take with you.</em></h2>
      <p class="intro-text">We create clear, beautifully considered travel guides that help you spend less time planning and more time experiencing Portugal — one town, one table and one memorable view at a time.</p>
    </section>

    <section class="destinations section-wrap" id="destinations">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Choose your next stop</p>
          <h2>Places with a story</h2>
        </div>
        <p class="section-aside">A first collection of guides<br>to explore Portugal more deeply.</p>
      </div>
      <div class="destination-grid">
        {homeDestinations.map((d) => <DestinationCard {...d} />)}
      </div>
    </section>

    <section class="guide-feature" id="guides">
      <div class="guide-art" aria-hidden="true"></div>
      <div class="guide-content">
        <p class="eyebrow">The first field guide</p>
        <h2>Get to know<br><em>Sintra properly.</em></h2>
        <p>A practical, independent guide to planning your day: what to prioritise, how to move around, where to pause and the details worth knowing before you go.</p>
        <div class="guide-meta"><span>Digital guide</span><span>·</span><span>Designed for curious travellers</span></div>
        <a class="button button-outline" href="sintra.html">Read the field guide <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="values section-wrap" id="about">
      <p class="eyebrow">The Portugal Guide philosophy</p>
      <h2>Good travel is in<br><em>the details.</em></h2>
      <div class="values-grid">
        <article><span class="value-number">01</span><h3>Useful, not overwhelming</h3><p>Practical information, carefully selected, so you can make confident decisions.</p></article>
        <article><span class="value-number">02</span><h3>A local point of view</h3><p>Context and character that help you understand the places you are visiting.</p></article>
        <article><span class="value-number">03</span><h3>Time well spent</h3><p>Thoughtful routes and realistic advice that leave room for unexpected moments.</p></article>
      </div>
    </section>

    <section class="closing">
      <p class="eyebrow">Portugal is waiting</p>
      <h2>Take the scenic route.</h2>
      <a href="sintra.html" class="text-link">Explore the Sintra guide <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</Base>
