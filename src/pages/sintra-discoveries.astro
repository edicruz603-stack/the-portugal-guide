---
// Ported from legacy /sintra-discoveries.html by scripts/port-legacy.mjs (Phase 1).
// Editorial content is unchanged; see docs/phase-0-1-report.md.
import Base from '../layouts/Base.astro';
import DirectoryPlaceCard from '../components/places/DirectoryPlaceCard.astro';
import DirectoryEvent from '../components/events/DirectoryEvent.astro';
import { placesInList, eventsInList } from '../lib/content/repository.ts';
const directory = await placesInList('destination.sintra', 'list.sintra.directory', 'directory');
const diary = await eventsInList('destination.sintra', 'list.sintra.events-directory', 'directory');
---
<Base
  title="Explore Sintra · The Portugal Guide"
  description="An independent curated directory of Sintra monuments, free discoveries, restaurants, cafés and events."
  nav={[["sintra.html","Sintra field guide"],["#places","Discoveries"],["#events","Seasonal diary"]]}
>
<main id="main" tabindex="-1" class="explore"><p class="ey">The Sintra Field Companion · Curated directory</p><h1>There is more to Sintra<br>than the famous palaces.</h1><p class="lead">Find the great monuments, free discoveries, places to eat and the little detours that make a day memorable. Every stop has a practical reason to go and a direct map link. This is an editorial starting point, not a live booking or opening-hours service.</p><section id="places"><h2>Find your kind of Sintra.</h2><input type="search" class="search" id="search" placeholder="Search places, food, gardens, viewpoints…" aria-label="Search Sintra places"><div class="toolbar" role="group" aria-label="Filter places"><button type="button" class="active" data-filter="all">All places</button><button type="button" data-filter="monument">Monuments</button><button type="button" data-filter="free">Free discoveries</button><button type="button" data-filter="food">Food &amp; cafés</button></div><p class="fine" id="count" aria-live="polite">{directory.length} curated stops</p><div class="cards" id="cards">{directory.map(({ editorial }) => <DirectoryPlaceCard editorial={editorial} />)}</div></section><section id="routes"><p class="ey">Editorial route ideas</p><h2>Three ways to discover the town.</h2><div class="route"><h3>01 · The free historic-centre trail</h3><p>Start near Sintra station → Museu Anjos Teixeira → Parque da Liberdade → National Palace gardens → São Martinho viewpoint → Lawrence’s Hotel exterior. A flexible collection of nearby stops, not a verified step-free route. Check museum hours.</p><a href="https://www.google.com/maps/dir/?api=1&amp;origin=Sintra+Train+Station&amp;destination=Lawrences+Hotel+Sintra&amp;waypoints=Museu+Anjos+Teixeira+Sintra%7CParque+da+Liberdade+Sintra%7CPalacio+Nacional+de+Sintra%7CIgreja+de+Sao+Martinho+Sintra&amp;travelmode=walking" target="_blank" rel="noopener">Open proposed walking route ↗</a></div><div class="route"><h3>02 · The palace-hills day</h3><p>Pena Palace and the Moorish Castle are natural companions for travellers comfortable with hills and steps. Do not assume private cars can reach either entrance. Add Santa Eufémia only after checking access and the time needed.</p><a href="https://www.parquesdesintra.pt/pt/planear-a-visita/" target="_blank" rel="noopener">Check access restrictions ↗</a></div><div class="route"><h3>03 · Pastry comparison, not a rushed checklist</h3><p>Compare a travesseiro at Piriquita with a queijada at Sapa; Café Saudade makes a more leisurely café stop near the station. Choose one or two stops depending on appetite and queues.</p><a href="https://www.google.com/maps/search/?api=1&amp;query=pastry+shops+Sintra" target="_blank" rel="noopener">Explore pastry stops ↗</a></div></section><section class="section-gap" id="events"><p class="ey">Seasonal diary · Checked 30 October 2026</p><h2>What is happening in Sintra?</h2><p class="lead">A snapshot from the municipal agenda. Dates can change and events may sell out. This page does not update itself automatically yet; use the official agenda for the latest programme.</p>{diary.map(({ editorial }) => <DirectoryEvent editorial={editorial} />)}<p><a href="https://cm-sintra.pt/agenda" target="_blank" rel="noopener">Check the official municipal events calendar ↗</a></p></section><section class="section-gap"><h2>Before you set off</h2><p class="lead">Sintra is steep. The Pena Palace requires a dated time reservation, private-car access to Pena and the Moorish Castle is restricted, and temporary works may affect routes to Monserrate and Santa Eufémia. Free museums have limited opening hours. Confirm official access, prices, and accessibility before committing to a plan.</p><p class="fine">Research sources: Câmara Municipal de Sintra, Visit Sintra, Parques de Sintra, Visit Portugal, and business listing data. Curated 30 October 2026. Recommendations are independent; listings are not paid placements. This page is an expanded research edition, not the finished paid product.</p><p><a href="sintra.html">← Return to the main Sintra field guide</a></p></section></main>
</Base>

<style is:global>
/* Page styles ported from legacy sintra-discoveries.html: colours/fonts re-pointed to tokens; token overrides and shared header/footer rules removed. */
body{background:var(--ivory);color:var(--forest);font-family:var(--font-sans)}.explore{max-width:1160px;margin:auto;padding:70px 24px 100px}.ey{font-size:11px;letter-spacing:.17em;text-transform:uppercase;color:var(--gold-text);font-weight:700}.explore h1{font:500 clamp(43px,6vw,74px)/1.1 var(--font-serif);margin:15px 0 22px}.explore h2{font:500 clamp(30px,4vw,43px)/1.2 var(--font-serif)}.lead{max-width:740px;color:var(--muted);line-height:1.9}.toolbar{display:flex;flex-wrap:wrap;gap:9px;margin:30px 0 22px}.toolbar button{border:1px solid var(--forest);background:transparent;color:var(--forest);padding:11px 15px;font:600 12px var(--font-sans);cursor:pointer}.toolbar button.active{background:var(--forest);color:#fff}.search{padding:15px;border:1px solid var(--mist);background:#fff;width:100%;font:14px var(--font-sans);box-sizing:border-box}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px;margin:24px 0 70px}.place{background:var(--paper);padding:24px;border:1px solid var(--rule);display:flex;flex-direction:column}.place h3{font:500 25px/1.25 var(--font-serif);margin:12px 0}.place p{color:var(--muted);font-size:13px;line-height:1.8;flex:1}.meta{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--gold-text);font-weight:700}.links{display:flex;gap:15px;flex-wrap:wrap;margin-top:15px}.links a{font-size:12px;font-weight:700;color:var(--forest)}.event{padding:22px 0;border-top:1px solid var(--rule)}.event strong{font-size:18px}.event p{color:var(--muted);line-height:1.7}.event small,.fine{font-size:12px;color:var(--muted);line-height:1.8}.route{background:var(--forest);color:#fff;padding:26px;margin:14px 0}.route p{color:var(--paper);line-height:1.8}.route h3{font:500 26px var(--font-serif)}.route a{color:var(--gold-light)}.section-gap{margin-top:70px}@media(max-width:800px){.cards{grid-template-columns:1fr}.explore{padding:45px 18px 80px}.toolbar button{flex:1 1 40%}}[hidden]{display:none!important}
</style>

<script>
  import '../scripts/discoveries-filter.ts';
</script>
