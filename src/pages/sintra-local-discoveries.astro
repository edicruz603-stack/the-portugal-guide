---
// Ported from legacy /sintra-local-discoveries.html by scripts/port-legacy.mjs (Phase 1).
// Editorial content is unchanged; see docs/phase-0-1-report.md.
import Base from '../layouts/Base.astro';
import LocalPlaceItem from '../components/places/LocalPlaceItem.astro';
import LocalEvent from '../components/events/LocalEvent.astro';
import { placesInList, eventsInList } from '../lib/content/repository.ts';
const localFree = await placesInList('destination.sintra', 'list.sintra.local-free', 'local');
const localFood = await placesInList('destination.sintra', 'list.sintra.local-food', 'local');
const diary = await eventsInList('destination.sintra', 'list.sintra.events-local', 'local');
---
<Base
  title="Sintra Local Discoveries | The Portugal Guide"
  description="A local-minded companion to Sintra: free discoveries, cafés, restaurants, viewpoints and a dated cultural diary."
  nav={[["sintra.html","Sintra field guide"],["#free","Free discoveries"],["#food","Eat & drink"],["#events","What's on"],["sintra-romantic-guide.html","Romantic guide"]]}
>
<main id="main" tabindex="-1">
<section class="local-hero"><p class="tag" style="color:var(--gold-light)">The local atlas · Sintra</p><h1>Find the Sintra <em>between the monuments.</em></h1><p>A carefully selected companion to the famous palaces: small museums, free gardens, viewpoints, historic places, cafés and a cultural diary. Built to help you decide where to go, what is worth your time and how to make a better day.</p></section>
<section class="local-wrap" id="free"><p class="tag">01 · Spend less, discover more</p><h2>Sintra's free discoveries</h2><p class="lead">Free entry is not the same as always open, and public access can change. Check the linked official information on the day. Walking times below are deliberately not promised: Sintra's slopes, steps and cobbles make route choice important.</p>
<div class="cards">
{localFree.map(({ editorial }) => <LocalPlaceItem editorial={editorial} />)}
</div>
<div class="notice"><strong>Local walking note:</strong> Santa Eufémia, Vila Sassetti and the palace hills involve slopes and steps. Do not combine them into a single route without checking current access and your group's mobility. For the easiest old-town day, keep to the station, museum and historic-centre cluster.</div>
</section>
<section class="local-wrap" id="food" style="background:var(--paper);max-width:none;padding-left:max(24px,calc((100% - 1080px)/2));padding-right:max(24px,calc((100% - 1080px)/2))"><p class="tag">02 · Eat and drink</p><h2>Choose the right table<br><em>for the right moment.</em></h2><p class="lead">This is an editorial shortlist, not a paid ranking. Recommendations describe the kind of stop each place suits. Menus, prices, hours and quality can change; check directly before making a special journey.</p>
<div class="cards">
{localFood.map(({ editorial }) => <LocalPlaceItem editorial={editorial} />)}
</div>
</section>
<section class="local-wrap" id="events"><p class="tag">03 · Seasonal diary</p><h2>What's on in Sintra<br><em>Autumn and winter 2026.</em></h2><p class="lead">A dated snapshot checked against the official Sintra cultural agenda on 30 October 2026. Event dates, session times and availability can change; follow the organiser's link before travelling. The official cultural agenda is the live source, not this static page.</p>
<div class="events">
{diary.map(({ editorial }) => <LocalEvent editorial={editorial} />)}
</div>
<div class="notice"><strong>Keep the diary current:</strong> check <a href="https://agendaculturaldesintra.pt/agenda">Agenda Cultural de Sintra</a> and <a href="https://cm-sintra.pt/agenda">Câmara Municipal de Sintra — Agenda</a>. This page is a researched edition snapshot, not an automated event feed. A paid seasonal update must include a fresh editorial check and a visible “last checked” date.</div>
</section>
<section class="local-wrap" style="padding-top:10px"><p class="tag">Editorial standard</p><h2>Useful, honest, independent.</h2><p class="lead">We do not accept payment for inclusion. We distinguish official facts from editorial judgement, and we do not invent live opening status, walking times, prices or availability. If a detail is not verified, we say so. Always confirm transport, access, tickets and business opening hours with the operator before departure.</p><p><a href="sintra.html">← Return to the main Sintra Field Guide</a></p></section>
</main>
<Fragment slot="footer-note">Research snapshot: 30 October 2026. Event and business details can change. Sources: <a href="https://agendaculturaldesintra.pt/agenda">Sintra Cultural Agenda</a>, <a href="https://cm-sintra.pt/agenda">Sintra Municipality</a>, <a href="https://visitsintra.travel/">Visit Sintra</a> and official attraction operators.</Fragment>
</Base>

<style is:global>
/* Page styles ported from legacy sintra-local-discoveries.html: colours/fonts re-pointed to tokens; token overrides and shared header/footer rules removed. */
.local-hero{background:var(--forest);color:var(--ivory);padding:85px 8vw}.local-hero h1{font:600 clamp(44px,7vw,76px)/1.05 var(--font-serif);max-width:850px}.local-hero h1 em{color:var(--gold-light)}.local-hero p{max-width:700px;line-height:1.9;color:var(--paper)}.local-wrap{max-width:1080px;margin:auto;padding:65px 24px}.local-wrap h2{font:500 clamp(34px,5vw,52px)/1.1 var(--font-serif);color:var(--forest)}.local-wrap h2 em{color:var(--gold-text)}.lead{max-width:760px;line-height:1.9;color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);margin-top:30px}.item{background:var(--paper);padding:28px}.item h3{font:500 26px var(--font-serif);color:var(--forest);margin:0 0 10px}.item p{font-size:13px;line-height:1.85;color:var(--muted)}.item a,.local-wrap a{color:var(--forest);font-weight:700}.tag{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold-text);font-weight:700}.notice{border-left:3px solid var(--gold-text);padding:14px 18px;background:var(--ivory);color:var(--muted);font-size:13px;line-height:1.8;margin:24px 0}.events{border-top:1px solid var(--rule)}.event{display:grid;grid-template-columns:150px 1fr;gap:22px;padding:22px 0;border-bottom:1px solid var(--rule)}.event time{font-size:11px;font-weight:700;color:var(--gold-text)}.event h3{font:500 23px var(--font-serif);margin:0 0 6px}.event p{font-size:13px;line-height:1.8;color:var(--muted);margin:0}@media(max-width:680px){.cards{grid-template-columns:1fr}.event{grid-template-columns:1fr;gap:6px}.local-hero{padding:65px 7vw}}
</style>
