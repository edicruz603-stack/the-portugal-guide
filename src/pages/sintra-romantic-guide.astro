import Base from '../layouts/Base.astro';
import RomanticPlaceCard from '../components/places/RomanticPlaceCard.astro';
import { placesInList } from '../lib/content/repository.ts';
const romantic = await placesInList('destination.sintra', 'list.sintra.romantic', 'romantic');
---
<Base
  title="A Romantic Guide to Sintra | The Portugal Guide"
  description="A romantic field guide to Sintra, Portugal: palaces, gardens, quiet walks, viewpoints, cafés and thoughtful itineraries for two."
  nav={[["sintra.html","The Sintra field guide"],["sintra-local-discoveries.html","Local discoveries"],["#itineraries","Romantic itineraries"]]}
  cta={["sintra.html#companion","Build your day"]}
  footerLinks={[["sintra.html","The Sintra field guide"],["sintra-local-discoveries.html","Local discoveries"],["index.html","Home"]]}
>
<main id="main" tabindex="-1">
<section class="hero">
<div class="hero-copy">
<p class="eyebrow">A slower way to fall for Sintra</p>
<h1>Sintra,<br><em>made for lingering.</em></h1>
<p>A romantic field guide to mist-softened gardens, hidden paths, palaces shaped by imagination and long pauses over coffee. Come for the monuments; leave room for the moments between them.</p>
<a class="button" href="#itineraries">Find your kind of day ↓</a>
</div>
</section>
<section class="wrap intro">
<p class="eyebrow">A note before you begin</p>
<h2>Not a race from palace to palace.<br><em>A place to experience together.</em></h2>
<p>Sintra is at its best when you allow it to unfold slowly. The hills are steep, the weather can change quickly and the most memorable moments are not always behind a ticket gate. Choose one major visit, add a garden or a quiet lane, and leave space for an unplanned stop.</p>
</section>
<div class="wrap quote">“The loveliest part of a day in Sintra is often the time you did not schedule.”</div>
<section class="section">
<div class="wrap">
<div class="section-head"><p class="eyebrow">01 · Places with atmosphere</p><h2>Where the romance lives</h2><p>These places offer very different moods. Choose by the kind of experience you want, not by how many names you can fit into one day.</p></div>
<div class="cards">
{romantic.map(({ editorial }) => <RomanticPlaceCard editorial={editorial} />)}
</div>
</div>
</section>
<section class="section" id="itineraries">
<div class="wrap">
<div class="section-head"><p class="eyebrow">02 · Choose your rhythm</p><h2>Three ways to spend the day</h2><p>These are suggested sequences, not fixed tours. Timed tickets, transport and weather should decide the final order.</p></div>
<div class="itinerary"><div class="time">HALF A DAY</div><div><h3>A little Sintra, deeply felt</h3><p>For a short visit, keep everything close and choose one experience.</p><ul><li>Begin in the historic centre with a slow walk around the National Palace.</li><li>Choose either Quinta da Regaleira (if you have a suitable timed ticket) or the Vila Sassetti garden path.</li><li>Finish with coffee and a traditional pastry. Do not try to add Pena as a last-minute extra.</li></ul></div></div>
<div class="itinerary"><div class="time">ONE FULL DAY</div><div><h3>The classic romantic day</h3><p>A balanced day for a first visit, with one headline monument and time for the village.</p><ul><li>Morning: visit Pena Palace at your reserved time, or choose Regaleira if gardens and symbolism matter more to you.</li><li>Midday: return to the historic centre for lunch and a proper pause.</li><li>Afternoon: explore Vila Sassetti or a nearby garden, depending on energy and conditions.</li><li>Evening: choose a relaxed dinner in the village. Keep the final hour unscheduled.</li></ul></div></div>
<div class="itinerary"><div class="time">TWO DAYS</div><div><h3>The slow escape</h3><p>For visitors who want Sintra to feel like a stay rather than a checklist.</p><ul><li>Day one: Pena or Regaleira, followed by the historic centre and an unhurried meal.</li><li>Day two: Monserrate and its gardens, with time for the western side of the mountain.</li><li>If you have a car or a pre-arranged transfer, consider the Capuchos forest and the coast as a separate excursion rather than squeezing them into the same day.</li></ul></div></div>
<div class="note"><h3>A small but important truth</h3><p>Sintra is a mountain landscape, not a compact theme park. Pena, the Moorish Castle, Regaleira and Monserrate are not next-door neighbours. Private vehicles are restricted on some access roads, and bus routes or frequencies can change. Use the official transport and access information before committing to a sequence.</p><p><a href="https://www.parquesdesintra.pt/en/plan-your-visit/how-to-get-there/">Check official access and transport guidance ↗</a></p></div>
</div>
</section>
<section class="section">
<div class="wrap">
<div class="section-head"><p class="eyebrow">03 · The little rituals</p><h2>Make room for the in-between</h2></div>
<div class="cards">
<article class="card"><span class="number">A TABLE FOR TWO</span><h3>Stay for a proper meal</h3><p>Choose a place for the food and atmosphere, not only the quickest table. The local discoveries page has a curated starting list; menus, prices and opening times should always be checked directly.</p><a href="sintra-local-discoveries.html">Explore cafés and restaurants ↗</a></article>
<article class="card"><span class="number">A SMALL SWEET THING</span><h3>Try Sintra's pastries</h3><p>Make time for a travesseiro or queijada. They are part of the town's food identity and an easy way to turn a rushed stop into a proper pause.</p><a href="sintra-local-discoveries.html">Find pastry stops ↗</a></article>
<article class="card"><span class="number">WHEN THE MIST ARRIVES</span><h3>Let the plan change</h3><p>Move outdoor viewpoints and long woodland walks to a clearer spell. Choose an indoor visit or a café instead, but check that the attraction is open and your ticket still fits.</p></article>
<article class="card"><span class="number">A QUIETER MOMENT</span><h3>Walk without collecting</h3><p>Choose one garden path and give it your attention. Vila Sassetti's route is beautiful, but its moderate difficulty and steps mean it is not suitable for every visitor.</p><a href="https://www.parquesdesintra.pt/en/agenda/walking-route-vila-sassetti/" target="_blank" rel="noopener">Check route details ↗</a></article>
</div>
</div>
</section>
<section class="section">
<div class="wrap">
<div class="section-head"><p class="eyebrow">04 · Plan with confidence</p><h2>The practical details</h2><p>Romance is easier when the logistics are taken care of. These are the links worth checking before you travel.</p></div>
<div class="links">
<a href="sintra.html#companion">Build a personalised Sintra day <span>Time, interests, pace, mobility and transport</span></a>
<a href="sintra.html#map">Open the interactive Sintra map <span>Monuments and selected free discoveries</span></a>
<a href="https://www.parquesdesintra.pt/en/plan-your-visit/opening-times-and-prices/" target="_blank" rel="noopener">Official opening times and prices <span>Check current ticket options before buying</span></a>
<a href="https://www.parquesdesintra.pt/en/plan-your-visit/how-to-get-there/" target="_blank" rel="noopener">Official transport and access <span>Road restrictions, buses and arrival information</span></a>
<a href="https://www.cp.pt/passageiros/en" target="_blank" rel="noopener">CP train information <span>Check the current Lisbon–Sintra service</span></a>
<a href="sintra-local-discoveries.html">Local discoveries and cultural diary <span>Food, museums, gardens and seasonal events</span></a>
</div>
<p class="small" style="margin-top:25px">Editorial note · This is an independent guide and is not affiliated with the monument operators. Ticket prices and selected access details were checked against official sources on 30 October 2026. Quinta da Regaleira adult admission is €20 under its published 2026 tariff. They can change; always reconfirm before travel. Suggested visit durations are planning estimates, not official guarantees. No restaurant placement is paid.</p>
</div>
</section>
</main>
</Base>

