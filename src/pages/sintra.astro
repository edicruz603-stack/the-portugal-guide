---
// Ported from legacy /sintra.html by scripts/port-legacy.mjs (Phase 1).
// Editorial content is unchanged; see docs/phase-0-1-report.md.
import Base from '../layouts/Base.astro';
import MapView from '../components/MapView.astro';
import { placesInList, mapMarkers } from '../lib/content/repository.ts';
import FieldGuideCard from '../components/places/FieldGuideCard.astro';
import FoodCard from '../components/places/FoodCard.astro';
import MapLink from '../components/places/MapLink.astro';
const highlights = await placesInList('destination.sintra', 'list.sintra.field-guide-highlights', 'field_guide');
const freeCards = await placesInList('destination.sintra', 'list.sintra.field-guide-free', 'field_guide');
const tickets = await placesInList('destination.sintra', 'list.sintra.field-guide-tickets', 'field_guide_tickets');
const food = await placesInList('destination.sintra', 'list.sintra.field-guide-food', 'food_card');
const mapLinks = await placesInList('destination.sintra', 'list.sintra.map-links', 'map_link');
const sintraMapPlaces = await mapMarkers('destination.sintra', 'list.sintra.map');
---
<Base
  title="Sintra Field Guide — The Portugal Guide"
  description="Plan a thoughtful day in Sintra: palaces, gardens, practical routes, ticket advice and local details."
  nav={[["index.html#destinations","Destinations"],["index.html#our-way","Our way"],["index.html#about","About"]]}
  cta={["#day-plan","Plan your visit"]}
  bodyClass="guide-page"
>
<main id="main" tabindex="-1">
    <section class="guide-hero">
      <div class="guide-hero-copy">
        <p class="eyebrow">THE FIRST FIELD GUIDE · PORTUGAL</p>
        <h1>Sintra, <em>beyond the palaces.</em></h1>
        <p>A town wrapped in mist, gardens that feel like another world, and a mountain full of stories. Here is how to experience it with a little more time and a little less rushing.</p>
        <a class="button button-light" href="#day-plan">Plan your day <span aria-hidden="true">↓</span></a>
      </div>
      <div class="guide-hero-art" role="img" aria-label="Abstract illustration inspired by the green hills of Sintra"></div>
    </section>

    <nav class="guide-toc" aria-label="Guide contents">
      <a href="sintra-local-discoveries.html">Local discoveries</a><a href="sintra-romantic-guide.html">Romantic guide</a><a href="#first-look">First look</a><a href="#highlights">What to see</a><a href="#free-sintra">Free Sintra</a><a href="#getting-around">Getting around</a><a href="#plan">Itineraries</a><a href="#day-plan">Day plan</a><a href="#food">What to taste</a><a href="#photographs">Photographs</a><a href="#food-stops">Where to eat</a><a href="#tickets">Ticket budget</a><a href="#map">Interactive map</a><a href="#companion">Build my day</a><a href="#essentials">Before you go</a>
    </nav>

    <section class="section-wrap" style="padding-top:35px;padding-bottom:35px"><div style="background:var(--paper);padding:28px;border-left:4px solid var(--gold-text)"><p class="eyebrow">New · The growing Sintra directory</p><h2 style="font:500 clamp(27px,4vw,40px) var(--font-serif);margin:12px 0">30 places, free discoveries, food and seasonal events.</h2><p style="color:var(--muted);line-height:1.8">Explore a curated and searchable companion to this guide, with direct maps, practical tips, suggested routes and a dated events diary.</p><a class="button" href="sintra-local-discoveries.html">Explore the Sintra directory ↗</a></div></section>
    <section class="section-wrap" style="padding-top:18px;padding-bottom:18px"><div style="background:var(--forest);color:var(--ivory);padding:24px 28px;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap"><div><p class="eyebrow" style="color:var(--gold-light);margin:0 0 8px">A slower way to experience Sintra</p><h2 style="font:500 clamp(25px,4vw,36px) var(--font-serif);margin:0 0 6px">Discover our romantic field guide.</h2><p style="margin:0;color:rgba(244,238,223,.8);font-size:13px;line-height:1.7">Gardens, quiet paths, palaces and thoughtful itineraries for two.</p></div><a class="button" href="sintra-romantic-guide.html" style="white-space:nowrap">Explore the romantic guide ↗</a></div></section>
    <section class="guide-intro section-wrap" id="first-look">
      <p class="eyebrow">01 · Get your bearings</p>
      <h2>Let Sintra set<br><em>its own rhythm.</em></h2>
      <p>Sintra is not a place to squeeze into a hurried checklist. The historic centre, the forested hills and the monuments sit across a landscape that takes time to cross. Choose fewer stops, book timed entries carefully and leave room for the town itself.</p>
      <div class="guide-facts">
        <div><strong>Allow</strong><span>A full day for a first visit</span></div>
        <div><strong>Bring</strong><span>Comfortable shoes and a light layer</span></div>
        <div><strong>Expect</strong><span>Steep paths, changing weather and crowds</span></div>
      </div>
    </section>

    <section class="guide-highlights" id="highlights">
      <div class="section-wrap">
        <p class="eyebrow">02 · Choose your stops</p>
        <h2>Four places, four different moods.</h2>
        <div class="highlight-grid">
          {highlights.map(({ editorial }) => <FieldGuideCard editorial={editorial} />)}
        </div>
      </div>
    </section>

    <section class="guide-intro section-wrap" id="getting-around">
      <p class="eyebrow">03 · Move around wisely</p>
      <h2>Sintra is small on the map.<br><em>Not on the ground.</em></h2>
      <p>The monuments sit across the hills, not in one walkable cluster. The easiest plan is usually to arrive by train, use the local public transport or walk where the route makes sense, and avoid trying to drive from monument to monument.</p>
      <div class="guide-facts">
        <div><strong>By train</strong><span>Direct services connect Lisbon with Sintra. Check the timetable before setting off.</span></div>
        <div><strong>By bus</strong><span>Bus 434 serves the historic centre, Moorish Castle and Pena area. Check the operator’s current route and ticket conditions.</span></div>
        <div><strong>By car</strong><span>Private vehicles are restricted on access roads to Pena and in parts of the historic centre. Use designated parking and continue on foot or by public transport.</span></div>
      </div>
      <p style="margin-top:28px"><a class="text-link" href="https://www.parquesdesintra.pt/pt/planear-a-visita/como-chegar/" target="_blank" rel="noopener">Check the official access and transport guidance ↗</a></p>
    </section>

    <section class="guide-highlights" id="plan">
      <div class="section-wrap">
        <p class="eyebrow">05 · Choose your pace</p>
        <h2>Two ways to spend your time.</h2>
        <div class="highlight-grid">
          <article class="highlight-card"><span class="highlight-no">ONE DAY · FIRST VISIT</span><h3>The essential Sintra day</h3><p><strong>Morning:</strong> Book an early timed entry at Pena and allow time for the walk or transfer from the park entrance to the palace. <strong>Lunch:</strong> Return towards the historic centre and take a proper break. <strong>Afternoon:</strong> Visit Quinta da Regaleira if you have enough time and a suitable ticket slot. Keep the rest of the afternoon flexible.</p><p><strong>Best for:</strong> First-time visitors who want to experience two signature places without racing between every monument.</p></article>
          <article class="highlight-card"><span class="highlight-no">TWO DAYS · SLOWER EXPLORATION</span><h3>More gardens, less rushing</h3><p><strong>Day one:</strong> Explore Pena and the Moorish Castle, allowing time for the hill paths and viewpoints. Finish in the historic centre. <strong>Day two:</strong> Give Quinta da Regaleira a generous visit, then choose Monserrate for its gardens and architecture. Check transport connections before committing to the order.</p><p><strong>Best for:</strong> Travellers who enjoy gardens, architecture and a more relaxed pace.</p></article>
        </div>
        <p class="guide-disclaimer">These are planning frameworks, not timed guarantees. Check each attraction’s entry slot, travel time and current access conditions before booking. Avoid buying consecutive timed entries at different monuments unless you have confirmed the transfer.</p>
      </div>
    </section>

    <section class="guide-intro section-wrap" id="food">
      <p class="eyebrow">06 · A taste of Sintra</p>
      <h2>Save room for<br><em>something sweet.</em></h2>
      <p>Sintra has its own pastry traditions. Look out for two classics in the village: <strong>travesseiros</strong>, flaky pastries traditionally filled with an almond-and-egg cream, and <strong>queijadas</strong>, small cheese-based tarts with a lightly spiced, caramelised finish. They are part of the town’s food identity, not just souvenirs.</p>
      <div class="guide-facts">
        <div><strong>Travesseiro</strong><span>Best enjoyed freshly made, ideally still slightly warm.</span></div>
        <div><strong>Queijada</strong><span>A small traditional tart with a rich, gently sweet filling.</span></div>
        <div><strong>Local tip</strong><span>Take a break in the historic centre rather than trying to eat between bus connections.</span></div>
      </div>
      <p style="margin-top:28px"><a class="text-link" href="https://visitsintra.travel/en" target="_blank" rel="noopener">Explore the official Visit Sintra guide ↗</a></p>
    </section>

    <section class="guide-plan section-wrap" id="day-plan">
      <p class="eyebrow">09 · A realistic first day</p>
      <h2>One day in Sintra.<br><em>Without the sprint.</em></h2>
      <p class="plan-lead">A suggested structure, not a race. Pick two major monuments rather than trying to see everything in one day.</p>
      <div class="timeline">
        <article><span>Morning</span><div><h3>Start with your timed ticket</h3><p>Visit the monument you most want to see first. For many first-time visitors, that is Pena or Regaleira. Check the official entry time and transport before leaving.</p></div></article>
        <article><span>Midday</span><div><h3>Pause in the historic centre</h3><p>Walk through the old town, have lunch and make time for a pastry. Avoid planning a tight transfer between timed entries.</p></div></article>
        <article><span>Afternoon</span><div><h3>Choose one more experience</h3><p>Regaleira, the Moorish Castle or Monserrate can each fill a meaningful part of the afternoon. Choose according to your interests and energy.</p></div></article>
        <article><span>Late day</span><div><h3>Leave space for the unexpected</h3><p>Return to the village, browse slowly and check your return transport. The last part of the day should not depend on a risky connection.</p></div></article>
      </div>
    </section>

    <section class="guide-highlights" id="photographs">
      <div class="section-wrap">
        <p class="eyebrow">A closer look · Four landmarks</p>
        <h2>See the character of each place.</h2>
        <p class="plan-lead">A small visual preview of the places in this guide. Each photograph is credited to its author and linked to its original licence record.</p>
        <div class="photo-grid">
          <figure class="photo-card"><img src="https://upload.wikimedia.org/wikipedia/commons/f/f1/Pal%C3%A1cio_Nacional_da_Pena%2C_sintra.jpg" alt="Palácio Nacional da Pena in Sintra"><figcaption><strong>Pena Palace</strong>Photo: Pakycassano · CC BY-SA 4.0 · <a href="https://commons.wikimedia.org/wiki/File:Pal%C3%A1cio_Nacional_da_Pena,_sintra.jpg" target="_blank" rel="noopener">Original file and licence</a></figcaption></figure>
          <figure class="photo-card"><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/9/96/Regaleira_Initiation_Well.JPG/960px-Regaleira_Initiation_Well.JPG" alt="The Initiation Well at Quinta da Regaleira"><figcaption><strong>Quinta da Regaleira</strong>Photo: Husond · CC BY-SA 3.0 · <a href="https://commons.wikimedia.org/wiki/File:Regaleira_Initiation_Well.JPG" target="_blank" rel="noopener">Original file and licence</a></figcaption></figure>
          <figure class="photo-card"><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/28/Castelo_dos_Mouros._Sintra%2C_Portugal.jpg/960px-Castelo_dos_Mouros._Sintra%2C_Portugal.jpg" alt="Stone walls of Castelo dos Mouros above Sintra"><figcaption><strong>Moorish Castle</strong>Photo: Ввласенко · CC BY-SA 3.0 · <a href="https://commons.wikimedia.org/wiki/File:Castelo_dos_Mouros._Sintra,_Portugal.jpg" target="_blank" rel="noopener">Original file and licence</a></figcaption></figure>
          <figure class="photo-card"><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Pal%C3%A1cio_de_Monserrate_DSC08899_%2836939236406%29.jpg/960px-Pal%C3%A1cio_de_Monserrate_DSC08899_%2836939236406%29.jpg" alt="Ornate exterior of Palácio de Monserrate"><figcaption><strong>Monserrate Palace</strong>Photo: nborges · CC BY 2.0 · <a href="https://commons.wikimedia.org/wiki/File:Pal%C3%A1cio_de_Monserrate_DSC08899_(36939236406).jpg" target="_blank" rel="noopener">Original file and licence</a></figcaption></figure>
        </div>
      </div>
    </section>

    <section class="guide-highlights" id="tickets">
      <div class="section-wrap">
        <p class="eyebrow">07 · Plan your budget</p>
        <h2>Know what your tickets cover.</h2>
        <p class="plan-lead">Adult reference prices currently published by the operators, checked on 30 October 2026. These are separate admissions, not a combined pass. Transport, food and optional transfers are extra.</p>
        <div class="highlight-grid">
          <article class="highlight-card"><span class="highlight-no">PARQUES DE SINTRA · ADULT 18–64</span><h3>Signature monuments</h3><p><strong>Pena Palace · Essential visit:</strong> €20. <strong>Pena Park only:</strong> €12. The optional park-to-palace transfer is an additional €4.50 return. <strong>Moorish Castle:</strong> €12. <strong>Monserrate Park and Palace:</strong> €12. <strong>National Palace of Sintra:</strong> €13. The National Palace gardens are listed as free entry.</p><a href="https://www.parquesdesintra.pt/pt/planear-a-visita/horarios-e-precos/" target="_blank" rel="noopener">Check official prices and hours ↗</a></article>
          {tickets.map(({ editorial }) => <FieldGuideCard editorial={editorial} />)}
        </div>
        <p class="guide-disclaimer">Prices checked on 30 October 2026 against the official operators. Adult rates apply to ages 18–64; other age bands, family tickets and special conditions differ. Prices and visit formats can change. Confirm the exact product and date before paying. Sources: Parques de Sintra and Fundação Cultursintra.</p>
      </div>
    </section>


    <section class="guide-highlights" id="free-sintra">
      <div class="section-wrap">
        <p class="eyebrow">A different Sintra · Mostly free discoveries</p>
        <h2>The places you can enjoy<br><em>without buying a palace ticket.</em></h2>
        <p class="plan-lead">Some of Sintra’s best moments happen between the famous monuments. This small-town trail brings together public gardens, a free museum, a viewpoint and a remarkable historic hotel. Check opening hours before you go; “free” does not always mean open at every hour.</p>
        <div class="highlight-grid">
          {freeCards.map(({ editorial }) => <FieldGuideCard editorial={editorial} />)}
        </div>
        <p class="guide-disclaimer">Free-entry information and opening hours checked against official visitor sources on 30 October 2026. Temporary closures, maintenance and special-event restrictions may apply. The museum is free according to Visit Sintra; the National Palace gardens are explicitly listed as free by Parques de Sintra. The Parque da Liberdade is a public municipal park.</p>
      </div>
    </section>

    <section class="guide-intro section-wrap" id="map">
      <p class="eyebrow">08 · Explore the map</p>
      <h2>Understand the lay of<br><em>the Sintra hills.</em></h2>
      <p>Use this map to understand where the main sights sit in relation to the historic centre. It is a location guide, not a suggested walking route: the hills are steep, and some roads are closed to private vehicles.</p>
      <div class="map-legend"><span><i class="map-dot"></i> Main monuments</span><span><i class="map-dot green"></i> Free stops</span></div>
      <MapView id="sintra-map" places={sintraMapPlaces} label="Interactive map of Sintra visitor areas" />
      <p class="map-note">Map data © OpenStreetMap contributors. Monument locations are approximate visitor-area markers; follow official directions for the correct entrance and access route.</p>
      <div class="official-links" style="margin-top:24px">
        {mapLinks.map(({ editorial }) => <MapLink editorial={editorial} />)}
      </div>
    </section>

    <section class="guide-highlights" id="food-stops">
      <div class="section-wrap">
        <p class="eyebrow">Local stops · Eat and pause</p>
        <h2>Good places for a proper pause.</h2>
        <p class="plan-lead">A short, practical shortlist in and around the historic centre. These are independent suggestions, not paid placements. Check opening times and menus before setting off.</p>
        <div class="food-grid">
          {food.map(({ editorial }) => <FoodCard editorial={editorial} />)}
        </div>
        <p class="guide-disclaimer">Food recommendations are selected for their local character and location. Menus, prices, service and opening hours can change; check directly with each business. The Portugal Guide is independent and receives no payment for these listings.</p>
      </div>
    </section>

    <section class="guide-intro section-wrap" id="companion">
      <p class="eyebrow">Your personal field companion</p>
      <h2>Build a day that<br><em>fits you.</em></h2>
      <p>This planner does more than list attractions. It helps you choose a realistic combination based on your time, interests, travel style and mobility. It deliberately avoids squeezing too many timed visits into one day.</p>
      <div class="companion-tool">
        <p class="eyebrow">The Sintra day builder</p>
        <h3 style="font:500 30px var(--font-serif);margin:0 0 10px">Tell us how you like to travel.</h3>
        <p style="font-size:13px;line-height:1.8;color:rgba(255,255,255,.78)">Choose the options below to receive a practical starting plan. This is a planning aid, not a live ticket or transport availability checker.</p>
        <div class="companion-fields">
          <label>How much time do you have?
            <select id="sc-days"><option value="one">One day</option><option value="two">Two days</option><option value="half">Half a day</option></select>
          </label>
          <label>What interests you most?
            <select id="sc-interest"><option value="classic">The iconic palaces and history</option><option value="gardens">Gardens, nature and scenery</option><option value="culture">Architecture, history and culture</option><option value="food">Food, cafés and the old town</option><option value="family">A balanced family day</option></select>
          </label>
          <label>What is your preferred pace?
            <select id="sc-pace"><option value="relaxed">Relaxed — fewer stops</option><option value="balanced">Balanced — a full day</option><option value="active">Active — happy to walk more</option></select>
          </label>
          <label>Any mobility considerations?
            <select id="sc-mobility"><option value="standard">No particular limitation</option><option value="low">Prefer less walking and fewer stairs</option><option value="stepfree">Need step-free access where possible</option></select>
          </label>
          <label>How will you arrive?
            <select id="sc-transport"><option value="train">By train</option><option value="car">By car</option><option value="local">Already staying in Sintra</option></select>
          </label>
          <label>Who is travelling?
            <select id="sc-company"><option value="solo">Solo</option><option value="couple">As a couple</option><option value="family">With children</option><option value="group">With friends or a group</option></select>
          </label>
        </div>
        <button type="button" id="sc-build">Build my suggested plan ↗</button>
        <div class="companion-result" id="sc-result" aria-live="polite" hidden></div>
      </div>
      <div class="decision-grid">
        <article class="decision-card"><h3>When the weather turns</h3><p>Keep outdoor viewpoints and long hill walks flexible. Move towards indoor palace rooms, cafés and the historic centre, but check which interiors are open and whether your ticket covers them. Do not assume every monument remains accessible in severe weather.</p></article>
        <article class="decision-card"><h3>When tickets are sold out</h3><p>Do not buy a random third-party ticket without checking what it includes. Rebuild the day around a monument with official availability, or switch to a garden, village and viewpoint day. Pena requires a dated time slot.</p></article>
        <article class="decision-card"><h3>When you are running late</h3><p>Protect the timed entry you have already booked. Drop the next distant monument rather than rushing across the hills. A missed slot can cost more than a missed photo stop.</p></article>
        <article class="decision-card"><h3>When walking is difficult</h3><p>Choose fewer sites, check each monument’s accessibility page and contact the operator before booking. Historic gardens, cobbled streets and hilltop sites can include steep slopes, steps and uneven surfaces.</p></article>
      </div>
    </section>

    <section class="guide-essentials" id="essentials">
      <div class="section-wrap essentials-inner">
        <div><p class="eyebrow">10 · Before you go</p><h2>The details<br><em>that make the day.</em></h2></div>
        <div class="essentials-list">
          <article><h3>Book the important entries</h3><p>Pena Palace uses date and time reservations. Regaleira also sells timed tickets through its official ticket office. Check availability directly before travelling.</p></article>
          <article><h3>Do not assume the monuments are next door</h3><p>Sintra’s attractions are spread across the hills. Road traffic, queues and walking distances can make transfers take longer than expected.</p></article>
          <article><h3>Dress for the mountain</h3><p>Conditions can be cooler, windier or mistier than in Lisbon. Wear shoes with grip and bring a light jacket, even on a warm day.</p></article>
          <article><h3>Check official updates on the day</h3><p>Opening times, access restrictions and ticket conditions can change. The official operators are the final source of truth.</p></article>
        </div>
      </div>
    </section>

    <section class="guide-links section-wrap">
      <p class="eyebrow">Useful official links</p>
      <h2>Plan with confidence.</h2>
      <div class="official-links">
        <a href="https://www.parquesdesintra.pt/pt/planear-a-visita/horarios-e-precos/" target="_blank" rel="noopener"><span>Parques de Sintra</span><small>Opening times, prices and visitor notices ↗</small></a>
        <a href="https://www.regaleira.pt/pt/visitas" target="_blank" rel="noopener"><span>Quinta da Regaleira</span><small>Tickets and visit information ↗</small></a>
        <a href="https://www.cp.pt/" target="_blank" rel="noopener"><span>Comboios de Portugal</span><small>Train schedules and tickets ↗</small></a>
      </div>
      <p class="guide-disclaimer">This independent guide is for planning inspiration. It is not affiliated with or endorsed by the monuments or transport operators. Always confirm current details with the official providers. Information reviewed on 30 October 2026. Transport routes, access rules, opening times and ticket prices can change; verify them with the official providers before departure.</p>
    </section>
  </main>
</Base>

<style is:global>
/* Page styles ported from legacy sintra.html: colours/fonts re-pointed to tokens; token overrides and shared header/footer rules removed. */
.guide-hero{min-height:590px;display:grid;grid-template-columns:1.05fr .95fr;background:var(--forest);color:var(--ivory)}.guide-hero-copy{padding:95px 5vw 90px 10vw;align-self:center}.guide-hero-copy .eyebrow{color:var(--gold-light)}.guide-hero-copy h1{font-size:clamp(48px,6vw,78px);line-height:1.04}.guide-hero-copy h1 em{color:var(--gold-light)}.guide-hero-copy>p:not(.eyebrow){max-width:490px;color:rgba(255,255,255,.82);font-size:15px;line-height:1.9}.guide-hero-art{min-height:480px;background:radial-gradient(ellipse at 68% 24%,rgba(205,181,122,.78) 0 7%,transparent 7.5%),radial-gradient(ellipse at 32% 75%,rgba(126,106,51,.72),transparent 38%),repeating-linear-gradient(155deg,transparent 0 48px,rgba(235,226,204,.12) 49px 51px),linear-gradient(145deg,#78866a,var(--forest) 55%,var(--forest-deep))}.guide-toc{display:flex;justify-content:center;flex-wrap:wrap;gap:28px;padding:22px 5vw;background:var(--paper);border-bottom:1px solid rgba(31,58,45,.15)}.guide-toc a{font-size:11px;letter-spacing:.06em;white-space:nowrap}.guide-intro{padding-top:105px;padding-bottom:105px}.guide-intro h2,.guide-plan h2,.essentials-inner h2{font-size:clamp(42px,5vw,62px);line-height:1.12}.guide-intro h2 em,.guide-plan h2 em{color:var(--gold-text)}.guide-intro>p:not(.eyebrow){max-width:690px;color:var(--muted);line-height:1.95;font-size:15px}.guide-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;margin-top:48px;padding-top:25px;border-top:1px solid rgba(31,58,45,.2)}.guide-facts div{display:grid;gap:8px}.guide-facts strong{color:var(--gold-text);font-family:var(--font-serif);font-size:21px;font-weight:500}.guide-facts span{color:var(--muted);font-size:12px;line-height:1.6}.guide-highlights{padding:95px 0 105px;background:var(--paper)}.guide-highlights h2,.guide-links h2{max-width:600px;margin-bottom:45px;font-size:clamp(38px,5vw,55px)}.highlight-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:rgba(31,58,45,.18);border:1px solid rgba(31,58,45,.18)}.hig